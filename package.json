{
  "name": "automated-mail-sender",
  "version": "2.0.0",
  "description": "Production-grade automated email dispatcher for job applications and referral requests with rate-limiting, deduplication, and multi-auth support.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dry-run": "node index.js --dry-run",
    "send:application": "node index.js",
    "send:referral": "node refferals.js",
    "send:referral:dry-run": "node refferals.js --dry-run",
    "send:referral-oauth": "node refferal2.js",
    "test:dry-run": "node index.js --dry-run --file data/recipients.sample.csv"
  },
  "keywords": [
    "nodemailer",
    "email-automation",
    "job-application",
    "referral-request",
    "oauth2",
    "rate-limiting"
  ],
  "author": "Kunal Shinde",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.6.1",
    "googleapis": "^154.1.0",
    "nodemailer": "^7.0.5"
  }
}
